# Credenciais do Supabase para o projeto Medlife
# Substitua os valores abaixo pelas chaves reais do seu projeto no Supabase

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Se for rodar a migração local, use a service_role_key para ignorar políticas de RLS durante o upload
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
